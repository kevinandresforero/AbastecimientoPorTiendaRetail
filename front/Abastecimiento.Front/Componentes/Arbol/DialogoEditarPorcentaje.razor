@inherits PaginaBase

<Dialogo Titulo="@($"Editar porcentaje de {Nodo.Nombre}")">
    <EditForm Model="formulario" OnValidSubmit="GuardarAsync">
        <DataAnnotationsValidator />
        <ResumenErroresApi Error="error" AliasCampos="AliasCampos" />
        <ValidationSummary class="alert alert-danger resumen-validacion" />

        <p class="texto-secundario mb-2">Ruta: @Nodo.Ruta</p>
        <label class="form-label" for="porcentaje-editar">Porcentaje de participación (%)</label>
        <div class="input-group">
            <InputText id="porcentaje-editar" class="form-control" inputmode="decimal" placeholder="Ej. 30 o 30,5"
                       @bind-Value="formulario.Porcentaje" />
            <span class="input-group-text">%</span>
        </div>
        <ValidationMessage For="() => formulario.Porcentaje" />
        <AyudaPorcentaje SumaHermanos="SumaHermanos" />

        <div class="d-flex justify-content-end gap-2 mt-4">
            <button type="button" class="btn btn-outline-primary" @onclick="CancelarAsync">Cancelar</button>
            <button type="submit" class="btn btn-primary" disabled="@enviando">@(enviando ? "Guardando…" : "Guardar")</button>
        </div>
    </EditForm>
</Dialogo>
