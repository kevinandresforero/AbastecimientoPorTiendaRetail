@inherits LayoutComponentBase

<div class="app">
    <aside class="barra-lateral" aria-label="Menú principal">
        <input type="checkbox" id="menu-movil" class="menu-movil-control" aria-label="Mostrar u ocultar el menú" />
        <div class="barra-cabecera">
            <a class="marca-app" href="">
                <span class="marca-logo"><Icono Nombre="carga" /></span>
                <span class="marca-texto">
                    <strong>Abastecimiento</strong>
                    <small>Carga por tienda</small>
                </span>
            </a>
            <label for="menu-movil" class="menu-movil-boton"><Icono Nombre="menu" /> Menú</label>
        </div>
        <NavMenu />
        <p class="barra-pie">Lili Pink · Yoi · Yahad</p>
    </aside>

    <main class="contenido">
        <div class="contenido-interno">
            @Body
        </div>
    </main>
</div>

<div id="blazor-error-ui" role="alert">
    Error: ocurrió un problema inesperado.
    <a href="" class="reload">Recargar</a>
    <button type="button" class="dismiss btn btn-sm btn-outline-primary">Cerrar</button>
</div>
