# Copiar a .env (no se versiona):  cp .env.example .env
# Contrasena solo para desarrollo / evaluacion (SQL Server exige minimo 8 caracteres con mayusculas, minusculas, numeros y simbolos).

# docker compose: contrasena del contenedor de SQL Server (la API del compose arma su propia cadena con host "db").
MSSQL_SA_PASSWORD=Abastecimiento#2026

# dotnet run (API fuera de Docker): la API carga este archivo al arrancar y esta variable reemplaza
# la cadena LocalDB de appsettings.json. Apunta al SQL Server del compose expuesto en localhost:14333.
ConnectionStrings__Abastecimiento=Server=localhost,14333;Database=Abastecimiento;User Id=sa;Password=Abastecimiento#2026;TrustServerCertificate=True

# dotnet test: base de datos aparte para las pruebas de integracion (repositorios y API).
# Las pruebas no leen este archivo: exportarla en la terminal antes de "dotnet test" (ver README).
ABASTECIMIENTO_PRUEBAS_SQL=Server=localhost,14333;Database=Abastecimiento_Pruebas;User Id=sa;Password=Abastecimiento#2026;TrustServerCertificate=True

# CORS (front web): la API ya permite http://localhost:3000, :5173 y :4200 (appsettings.json, indices 0-2).
# Para permitir otro origen sin tocar codigo, agregar un indice nuevo (en Docker, ponerlo en "environment" del servicio api):
# Cors__OrigenesPermitidos__3=http://localhost:8081
